# ===============================================
# SERVER CONFIGURATION
# ===============================================
PORT=4202
NODE_ENV=development

# ===============================================
# DATABASE - MongoDB
# ===============================================
# Local development - MongoDB running on localhost:27017
MONGO_URI=mongodb://100.100.56.54:27017/recruitment-hrms

# For Docker environment, use: mongodb://mongodb:27017/recruitment-hrms
# MONGO_URI=mongodb://mongodb:27017/recruitment-hrms

# ===============================================
# CACHE - Redis
# ===============================================
# Local development - Redis running on localhost:6379
REDIS_URL=100.100.56.54
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# For Docker environment, use:
# REDIS_URL=redis
# REDIS_PORT=6379

# ===============================================
# SECURITY - CORS (Allowed Domains)
# ===============================================
# Can be JSON array, comma-separated string, or single URL
ALLOWED_DOMINES=["http://localhost:4200","http://localhost:4201","http://localhost:8080","http://localhost:80","http://192.168.0.8:4201"]

# ===============================================
# SECURITY - JWT Token Secrets
# ===============================================
# ⚠️ IMPORTANT: Change these in production!
# Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=Satya@0427
REFRESH_TOKEN_SECRET=Satya@1234

# ===============================================
# TOKEN EXPIRATION
# ===============================================
ACCESS_TOKEN_EXPIRES=30m
REFRESH_TOKEN_EXPIRES_SEC=2592000

# ===============================================
# SECURITY - Bcrypt Salt Rounds
# ===============================================
SALT_ROUND=10

# ===============================================
# FILE UPLOAD - ImageKit Configuration
# ===============================================
# Get these from: https://imagekit.io/dashboard/
IMAGEKIT_PUBLIC_KEY=public_Oo7AmdsNAR3ib3zQvLu0DYuMZrU=
IMAGEKIT_PRIVATE_KEY=private_ohtIPrTHBmT9UqjLqoqNPLBPbgI=
IMAGEKIT_URLENDPOINT=https://ik.imagekit.io/sfmijw3gk

