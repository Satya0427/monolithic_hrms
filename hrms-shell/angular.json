{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"Hrms_Shell": {
			"projectType": "application",
			"schematics": {},
			"root": "",
			"sourceRoot": "src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular/build:application",
					"options": {
						"tsConfig": "tsconfig.app.json",
						"assets": [
							{
								"glob": "**/*",
								"input": "public",
								"output": "."
							}
						],
						"styles": [
							"src/styles.scss"
						],
						"browser": "src/main.ts",
						"outputPath": "dist/Hrms_Shell",
						"index": "src/index.html"
					},
					"configurations": {
						"production": {
							"fileReplacements": [
								{
									"replace": "src/environments/environement.ts",
									"with": "src/environments/environement.prod.ts"
								}
							],
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "4mb",
									"maximumError": "8mb"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "16kb",
									"maximumError": "20kb"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"fileReplacements": [
								{
									"replace": "src/environments/environement.ts",
									"with": "src/environments/environement.dev.ts"
								}
							],
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						},
						"docker": {
							"fileReplacements": [
								{
									"replace": "src/environments/environement.ts",
									"with": "src/environments/environement.docker.ts"
								}
							],
							"optimization": true,
							"outputHashing": "all"
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular/build:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "Hrms_Shell:build:production"
						},
						"development": {
							"buildTarget": "Hrms_Shell:build:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4200
					}
				},
				"extract-i18n": {
					"builder": "@angular/build:extract-i18n"
				},
				"test": {
					"builder": "@angular/build:karma",
					"options": {
						"tsConfig": "tsconfig.spec.json",
						"assets": [
							{
								"glob": "**/*",
								"input": "public"
							}
						],
						"styles": [
							"src/styles.scss"
						]
					}
				}
			}
		}
	},
	"cli": {
		"analytics": false
	}
}